{
  "name": "pigallery2",
  "version": "3.6.0-edge",
  "description": "This is a photo gallery optimised for running low resource servers (especially on raspberry pi)",
  "author": "Patrik J. Braun",
  "homepage": "https://github.com/GitchalWoo/pigallery2.5/",
  "license": "MIT",
  "main": "./src/backend/index.js",
  "bin": "./src/backend/index.js",
  "scripts": {
    "build": "npm run build-backend && node scripts/build.mjs",
    "build-en": "npm run build-backend && node scripts/build.mjs --languages=en",
    "create-release": "node scripts/release.mjs",
    "build-backend": "tsc && node scripts/build-info.mjs",
    "pretest": "npm run build-backend",
    "test": "node --test scripts/test/*.test.mjs && ng test --watch=false && c8 mocha test",
    "test-frontend": "ng test --watch=false",
    "test-backend": "mocha test",
    "coverage": "c8 report --reporter=lcov",
    "start": "node ./src/backend/index",
    "run-diagnostics": "node ./src/backend/index --run-diagnostics --Server-Log-level=silly",
    "run-dev": "ng build  --configuration=dev",
    "build-stats": "ng build  --stats-json",
    "analyze": "webpack-bundle-analyzer dist/en/stats.json",
    "merge-new-translation": "node scripts/translations.mjs merge",
    "generate-man": "npm run build-backend && node scripts/generate-man.mjs",
    "lint": "ng lint",
    "start-e2e-server": "node ./test/folder-reset test/e2e && node ./src/backend/index --config-path=test/e2e/config.json --Database-dbFolder=test/e2e --Server-port=8080 --Users.suppressDefUserWarn=true",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "build-extension-interface": "tsc -p extension/ext-interface.tsconfig.json && tsc -p extension/ext-enums.tsconfig.json",
    "update-translation": "node scripts/translations.mjs update",
    "add-translation": "node scripts/translations.mjs add",
    "extract-locale": "node scripts/translations.mjs extract",
    "pretest-backend": "npm run build-backend",
    "pretest-backend-coverage": "npm run build-backend",
    "test-backend-coverage": "c8 mocha test",
    "test-tooling": "node --test scripts/test/*.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GitchalWoo/pigallery2.5.git"
  },
  "bugs": {
    "url": "https://github.com/GitchalWoo/pigallery2.5/issues"
  },
  "dependencies": {
    "adm-zip": "0.6.1",
    "archiver": "7.0.1",
    "bcrypt": "6.0.0",
    "better-sqlite3": "12.11.1",
    "cookie-parser": "1.4.7",
    "cookie-session": "2.1.1",
    "ejs": "3.1.10",
    "exif-reader": "2.0.2",
    "exifr": "7.1.3",
    "express": "5.2.1",
    "fast-xml-parser": "4.5.7",
    "image-size": "2.0.4",
    "multer": "2.4.0",
    "node-geocoder": "4.4.1",
    "nodemailer": "10.0.14",
    "openid-client": "6.8.8",
    "reflect-metadata": "0.2.2",
    "sharp": "0.35.5",
    "tslib": "2.8.1",
    "typeconfig": "2.3.4",
    "typeorm": "0.3.31"
  },
  "devDependencies": {
    "@angular-builders/custom-webpack": "22.0.1",
    "@angular-devkit/schematics": "22.2.1",
    "@angular/animations": "22.2.1",
    "@angular/cli": "22.2.1",
    "@angular/common": "22.2.1",
    "@angular/compiler": "22.2.1",
    "@angular/compiler-cli": "22.2.1",
    "@angular/core": "22.2.1",
    "@angular/forms": "22.2.1",
    "@angular/language-service": "22.2.1",
    "@angular/localize": "22.2.1",
    "@angular/platform-browser": "22.2.1",
    "@angular/platform-browser-dynamic": "22.2.1",
    "@angular/router": "22.2.1",
    "@bluehalo/ngx-leaflet": "22.0.0",
    "@bluehalo/ngx-leaflet-markercluster": "22.0.0",
    "@ng-icons/core": "36.1.0",
    "@ng-icons/ionicons": "36.1.0",
    "@schematics/angular": "22.2.1",
    "@types/adm-zip": "0.5.7",
    "@types/archiver": "6.0.3",
    "@types/bcrypt": "6.0.0",
    "@types/chai": "5.2.2",
    "@types/chai-as-promised": "^8.0.2",
    "@types/cookie-parser": "1.4.9",
    "@types/cookie-session": "2.0.49",
    "@types/ejs": "3.1.5",
    "@types/express": "5.0.6",
    "@types/jasmine": "5.1.8",
    "@types/leaflet": "1.9.20",
    "@types/leaflet.markercluster": "1.5.5",
    "@types/mocha": "10.0.10",
    "@types/multer": "1.4.12",
    "@types/node": "24.19.1",
    "@types/node-geocoder": "4.2.6",
    "@types/nodemailer": "6.4.17",
    "angular-eslint": "22.5.0",
    "bootstrap": "5.3.7",
    "c8": "12.0.0",
    "chai": "5.2.1",
    "chai-as-promised": "8.0.2",
    "chai-http": "5.1.2",
    "chokidar": "5.0.0",
    "cypress": "15.19.0",
    "deep-equal-in-any-order": "2.0.6",
    "eslint": "9.32.0",
    "eslint-plugin-chai-friendly": "1.1.0",
    "jasmine-core": "5.9.0",
    "karma": "6.4.4",
    "karma-chrome-launcher": "3.2.0",
    "karma-coverage": "2.2.1",
    "karma-jasmine": "5.1.0",
    "karma-jasmine-html-reporter": "2.1.0",
    "leaflet": "1.9.4",
    "leaflet.markercluster": "1.5.3",
    "marked-katex-extension": "5.1.6",
    "mocha": "11.7.1",
    "ngx-bootstrap": "22.0.0",
    "ngx-cookie-service": "22.0.0",
    "ngx-markdown": "22.1.0",
    "ngx-toastr": "20.0.5",
    "rxjs": "7.8.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "webpack-bundle-analyzer": "4.10.2",
    "xlf-google-translate": "1.0.1",
    "zone.js": "0.16.3"
  },
  "optionalDependencies": {
    "ffmpeg-static": "5.2.0",
    "ffprobe-static": "3.1.0",
    "mysql2": "3.24.5"
  },
  "engines": {
    "node": ">=24.15.0 <25.0.0",
    "npm": ">=11.19.0 <12.0.0"
  },
  "packageManager": "npm@11.19.0",
  "overrides": {
    "proxy-addr": "2.0.8",
    "ngx-toastr": {
      "@angular/common": "$@angular/common",
      "@angular/core": "$@angular/core"
    }
  }
}
